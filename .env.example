# ============================================================
# Maayan Nails — Environment Variables
# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings → Environment Variables.
# NEVER commit the real .env.local file — it is already in .gitignore.
# ============================================================

# --- Supabase --------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: SERVER-SIDE ONLY. Never expose to the browser, never
# prefix with NEXT_PUBLIC_. Used only in trusted server contexts
# (API routes / server actions) that need to bypass RLS deliberately
# (e.g. sending emails after a webhook, admin bootstrap script).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------
# The public URL of the deployed site (used for absolute links in emails, SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional Email (Resend) ----------------------------------
# Leave empty to run with email sending disabled (bookings still work;
# every email attempt is written to notification_logs with status="skipped").
RESEND_API_KEY=
EMAIL_FROM="Maayan Nails <appointments@yourdomain.co.il>"

# --- Future integrations (not active yet; wiring is in place) ------
# SMS / WhatsApp Business API provider credentials go here once approved.
WHATSAPP_API_TOKEN=
SMS_PROVIDER_API_KEY=

# --- Future payments (not active yet) -------------------------------
# ISRAELI_PAYMENT_PROVIDER_API_KEY=
